<body>

    <div class="container">
        <!-- الهيدر -->
        <div class="header-card">
            <h1 class="company-title">Khatib & Alami Company</h1>
            <div class="page-subtitle">شاشة البحث السريع للسنترال</div>
        </div>

        <!-- مربع البحث -->
        <div class="search-card">
            <input type="text" id="searchInput" class="search-input" placeholder="ابحث باسم الموظف، الداخلي، الجوال، القسم أو الطابق..." autofocus>
            <div class="results-count" id="resultsCount">جاري جلب البيانات...</div>
        </div>

        <!-- قائمة النتائج -->
        <div class="results-container" id="resultsList"></div>
    </div>

    <script>
        let allEmployees = [];

        // جلب البيانات مباشرة من ملف data.json المرفوع على GitHub
        async function fetchEmployeesData() {
            const resultsCount = document.getElementById('resultsCount');
            try {
                const response = await fetch('data.json?v=' + new Date().getTime());
                if (!response.ok) throw new Error('فشل جلب الملف');
                
                allEmployees = await response.json();
                renderResults(allEmployees);
            } catch (error) {
                console.error("خطأ في جلب البيانات:", error);
                resultsCount.textContent = "تعذر تحميل البيانات من السيرفر. جاري عرض البيانات المحفوظة محلياً...";
                
                // خيار احتياطي في حال عدم الاتصال
                const localData = localStorage.getItem('central_employees');
                if (localData) {
                    allEmployees = JSON.parse(localData);
                    renderResults(allEmployees);
                } else {
                    document.getElementById('resultsList').innerHTML = `<div class="no-results">تعذر تحميل بيانات الموظفين.</div>`;
                }
            }
        }

        function renderResults(employees) {
            const resultsList = document.getElementById('resultsList');
            const resultsCount = document.getElementById('resultsCount');

            resultsCount.textContent = `عدد النتائج: ${employees.length}`;

            if (!employees || employees.length === 0) {
                resultsList.innerHTML = `<div class="no-results">لا توجد نتائج مطابقة للبحث</div>`;
                return;
            }

            resultsList.innerHTML = employees.map(emp => `
                <div class="employee-card">
                    <div class="emp-name">${emp.name || 'غير محدد'}</div>
                    <div class="emp-info"><span>القسم / الإدارة:</span> <strong>${emp.department || '-'}</strong></div>
                    <div class="emp-info"><span>الرقم الداخلي:</span> <strong style="color: var(--primary); font-size: 16px;">${emp.extension || '-'}</strong></div>
                    <div class="emp-info"><span>رقم الجوال:</span> <strong>${emp.mobile || '-'}</strong></div>
                    <div class="emp-info"><span>الطابق / المبنى:</span> <strong>${emp.floor || '-'}</strong></div>
                </div>
            `).join('');
        }

        document.getElementById('searchInput').addEventListener('input', function(e) {
            const query = e.target.value.toLowerCase().trim();
            
            if (!query) {
                renderResults(allEmployees);
                return;
            }

            const filtered = allEmployees.filter(emp => {
                const name = (emp.name || '').toLowerCase();
                const dept = (emp.department || '').toLowerCase();
                const ext = (emp.extension || '').toString().toLowerCase();
                const mobile = (emp.mobile || '').toString().toLowerCase();
                const floor = (emp.floor || '').toLowerCase();

                return name.includes(query) || dept.includes(query) || ext.includes(query) || mobile.includes(query) || floor.includes(query);
            });

            renderResults(filtered);
        });

        // تشغيل جلب البيانات فور فتح الصفحة
        fetchEmployeesData();
    </script>
</body>
</html>
