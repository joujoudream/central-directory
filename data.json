            font-size: 14px;
            color: var(--text-muted);
            margin-bottom: 6px;
            display: flex;
            justify-content: space-between;
        }

        .emp-info strong {
            color: var(--text-main);
        }

        .no-results {
            grid-column: 1 / -1;
            background: var(--card-bg);
